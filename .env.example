# 复制为本地 .env 后使用：cp .env.example .env
# .env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。

# 必需：硅基流动 API Key，在 https://cloud.siliconflow.cn/account/ak 创建
SILICONFLOW_API_KEY=sk-your-key-here

# 可选：模型名，默认 Qwen/Qwen2.5-7B-Instruct；建议使用支持工具调用的模型
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 可选：接口地址，默认 https://api.siliconflow.cn/v1
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
